{
  "name": "klaket-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "migrate": "tsx db/migrate.ts",
    "seed": "tsx db/seed.ts",
    "migrate:seed": "tsx db/migrate.ts && tsx db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "local": "tsx local/start.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "17.10.0-beta.17",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.3",
    "vitest": "^2.1.8"
  }
}
