# ============================================================
# Cima — Frontend Environment Variables
# Copy to .env.local (Vite reads this automatically in dev)
# NEVER commit .env.local to git.
# ============================================================

# ---- Supabase -------------------------
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key


# ---- Uploads -------------------------
# Largest file Supabase accepts, in MB. The free plan caps every upload at 50 MB.
# After raising it in Supabase (Storage -> Settings) on a paid plan, set it here too.
# VITE_MAX_UPLOAD_MB=50
