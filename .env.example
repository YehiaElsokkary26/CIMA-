# ============================================================
# Cima — Frontend Environment Variables
# Copy to .env.local (Vite reads this automatically in dev)
# NEVER commit .env.local to git.
#
# IMPORTANT: every variable here is bundled into the browser build.
# NEVER put SUPABASE_SERVICE_ROLE_KEY (or any other secret) in a
# VITE_-prefixed variable — that key belongs only in server/.env.
# ============================================================

# ---- Supabase (public — safe for the browser) -------------------------
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

